---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { url } from '../data/url';
import { tasks, units, unitBySlug } from '../data/site';

// 搜尋索引：任務 + 單位服務 + 單位。全部在建置時產生，瀏覽器端比對。
const index = [
  ...tasks.map((t) => ({
    type: t.slug === 'emergency' ? '緊急' : '服務',
    title: t.title,
    desc: t.summary,
    href: t.slug === 'emergency' ? url('emergency') : url(`tasks/${t.slug}`),
    meta: t.units.map((u) => unitBySlug(u).name).join('、'),
    text: [t.title, t.verb, t.summary, ...t.keywords, ...t.audience, ...t.steps.map((s) => s.title)].join(' '),
  })),
  ...units.flatMap((u) =>
    u.services.map((s) => ({
      type: '項目',
      title: s.title,
      desc: s.desc,
      href: s.task ? (s.task === 'emergency' ? url('emergency') : url(`tasks/${s.task}`)) : url(`units/${u.slug}`),
      meta: u.name,
      text: [s.title, s.desc, u.name, u.short].join(' '),
    })),
  ),
  ...units.map((u) => ({ type: '單位', title: u.name, desc: u.summary, href: url(`units/${u.slug}`), meta: u.en, text: [u.name, u.short, u.en, u.summary].join(' ') })),
];
const suggestions = ['宿舍', '獎學金', '請假', '諮商', '學貸', '實習', '社團', '僑生'];
---
<Base title="服務搜尋" current="search">
  <header class="page-hero">
    <div class="wrap">
      <Breadcrumb items={[{ label: '服務搜尋' }]} />
      <p class="eyebrow">Search</p>
      <h1>你想找什麼服務？</h1>
      <form class="sbox" role="search" id="sform" action="" method="get">
        <label for="q" class="sr-only">搜尋服務、單位或關鍵字</label>
        <input id="q" name="q" type="search" placeholder="例如：宿舍、學貸、心理諮商" autocomplete="off" />
        <button class="btn btn-primary" type="submit">搜尋</button>
      </form>
      <p class="sugg"><span>試試：</span>{suggestions.map((s) => <button type="button" class="sugg-btn" data-q={s}>{s}</button>)}</p>
    </div>
  </header>

  <div class="wrap">
    <p id="status" class="status" role="status" aria-live="polite"></p>
    <ol id="results" class="results"></ol>
    <noscript><p>搜尋需要啟用 JavaScript。你也可以從<a href={url('tasks')}>服務總覽</a>瀏覽。</p></noscript>
    <section class="nohit card" id="nohit" hidden aria-labelledby="nh-h">
      <h2 id="nh-h">找不到？</h2>
      <p>換個說法試試，或直接打學務處總機 <a href="tel:+886229393091">02-2939-3091</a>，我們幫你轉接。</p>
      <p>緊急狀況請撥校安 24 小時專線 <a href="tel:+886919099119">0919-099-119</a>。</p>
    </section>
  </div>

  <script type="application/json" id="idx" set:html={JSON.stringify(index)} />
</Base>

<script>
  type Item = { type: string; title: string; desc: string; href: string; meta: string; text: string };
  const idx: Item[] = JSON.parse(document.getElementById('idx')!.textContent || '[]');
  const input = document.getElementById('q') as HTMLInputElement;
  const list = document.getElementById('results')!;
  const status = document.getElementById('status')!;
  const nohit = document.getElementById('nohit')!;
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const mark = (s: string, terms: string[]) => {
    let out = esc(s);
    for (const t of terms) if (t) out = out.split(esc(t)).join(`<mark>${esc(t)}</mark>`);
    return out;
  };
  const run = (q: string) => {
    const terms = q.trim().toLowerCase().split(/\s+/).filter(Boolean);
    if (!terms.length) { list.innerHTML = ''; status.textContent = ''; nohit.hidden = true; return; }
    const scored = idx
      .map((it) => {
        const hay = it.text.toLowerCase();
        const title = it.title.toLowerCase();
        let score = 0;
        for (const t of terms) {
          if (!hay.includes(t)) return null;
          score += title.includes(t) ? 3 : 1;
        }
        if (it.type === '服務' || it.type === '緊急') score += 1;
        return { it, score };
      })
      .filter(Boolean) as { it: Item; score: number }[];
    scored.sort((a, b) => b.score - a.score);
    const seen = new Set<string>();
    const res = scored.filter(({ it }) => { const k = it.href + it.title; if (seen.has(k)) return false; seen.add(k); return true; });
    list.innerHTML = res.map(({ it }) => `
      <li><a href="${it.href}">
        <span class="r-type">${esc(it.type)}</span>
        <span class="r-title">${mark(it.title, terms)}</span>
        <span class="r-desc">${mark(it.desc, terms)}</span>
        <span class="r-meta">${esc(it.meta)}</span>
      </a></li>`).join('');
    status.textContent = res.length ? `「${q}」找到 ${res.length} 筆結果` : `「${q}」沒有找到結果`;
    nohit.hidden = res.length > 0;
  };
  const params = new URLSearchParams(location.search);
  const initial = params.get('q') ?? '';
  input.value = initial;
  run(initial);
  let t: number | undefined;
  input.addEventListener('input', () => { clearTimeout(t); t = window.setTimeout(() => run(input.value), 150); });
  document.getElementById('sform')!.addEventListener('submit', (e) => {
    e.preventDefault();
    history.replaceState(null, '', input.value ? `?q=${encodeURIComponent(input.value)}` : location.pathname);
    run(input.value);
  });
  document.querySelectorAll<HTMLButtonElement>('.sugg-btn').forEach((b) => b.addEventListener('click', () => {
    input.value = b.dataset.q!;
    history.replaceState(null, '', `?q=${encodeURIComponent(input.value)}`);
    run(input.value);
    input.focus();
  }));
</script>

<style>
  .sbox { display: flex; gap: 10px; max-width: 680px; margin-top: 8px; }
  .sbox input { flex: 1; min-width: 0; font: inherit; font-size: 1.125rem; min-height: 56px; padding: 0 20px; border-radius: 999px; border: 1.5px solid var(--line); background: var(--surface); color: var(--ink); }
  .sbox input:focus { outline: 3px solid var(--focus); outline-offset: 2px; border-color: var(--focus); }
  .sbox input::placeholder { color: var(--ink-3); }
  .sbox .btn { min-height: 56px; padding-inline: 24px; }
  .sugg { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 16px; color: var(--ink-2); }
  .sugg-btn { font: inherit; font-size: .9375rem; min-height: 40px; padding: 0 14px; border-radius: 999px; border: 1.5px solid var(--line); background: transparent; color: var(--ink); cursor: pointer; }
  .sugg-btn:hover { border-color: var(--ink-2); }
  .status { margin: 32px 0 12px; color: var(--ink-2); }
  .results { list-style: none; padding: 0; margin: 0 0 32px; }
  .results :global(li a) { display: grid; grid-template-columns: 64px 1fr; gap: 2px 16px; padding: 18px 4px; border-bottom: 1px solid var(--line); text-decoration: none; color: var(--ink); }
  .results :global(li a:hover .r-title) { text-decoration: underline; }
  .results :global(.r-type) { grid-row: 1 / 4; font-size: .8125rem; font-weight: 700; color: var(--brand); padding-top: 4px; }
  .results :global(.r-title) { font-size: 1.1875rem; font-weight: 700; }
  .results :global(.r-desc) { color: var(--ink-2); font-size: .9375rem; }
  .results :global(.r-meta) { font-size: .8125rem; color: var(--ink-2); }
  .results :global(mark) { background: var(--accent-soft); color: inherit; padding: 0 2px; border-radius: 3px; }
  .nohit h2 { font-size: 1.375rem; }
  @media (max-width: 560px) {
    .sbox { flex-direction: column; }
    .results :global(li a) { grid-template-columns: 1fr; }
    .results :global(.r-type) { grid-row: auto; }
  }
</style>
