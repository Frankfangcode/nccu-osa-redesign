---
import Base from '../layouts/Base.astro';
import NewsList from '../components/NewsList.astro';
import { url } from '../lib/url';
import { tasks, news, units, audiences, featuredTasks, tel, phoneMain, campus24h } from '../lib/data';
import site from '../data/site.json';

const featured = featuredTasks;
const latest = news.slice(0, 6);
const duty = campus24h()[0];

// Online systems students use most, picked from the scraped unit menus.
const pick = (unit: string, title: string) =>
  units.find((u) => u.slug === unit)?.sections.flatMap((s) => s.links).find((l) => l.title === title);
const systems = [
  { label: '預約心理諮商初談', link: pick('health-center', '學生預約初談系統（SSO）') },
  { label: '查詢體檢結果', link: pick('health-center', '學生體檢結果查詢') },
  { label: '職涯平台（職缺與實習）', link: pick('career-center', '職涯平台首頁') },
  { label: '校外租屋資訊', link: pick('housing', '校外賃居資訊網') },
  { label: '社團補助申請', link: pick('student-activities', '學生社團補助線上申請') },
  { label: '樂活館場地登記', link: pick('student-activities', '樂活館使用登記系統') },
].filter((s) => s.link);
const mailbox = site.footerNotes.find((n: string) => /信箱/.test(n))?.match(/[\w.]+@[\w.]+/)?.[0];
---
<Base title="首頁" current="home">
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap">
      <h1 id="hero-title" class="hero-lead">我想</h1>
      <ul class="phrases" aria-label="常用服務">
        {featured.map((t) => (
          <li><a class="phrase" href={url(`/tasks/${t.slug}/`)}>{t.phrase}</a></li>
        ))}
        <li><a class="phrase phrase-more" href={url('/services/')}>看全部 {tasks.length} 項服務</a></li>
      </ul>

      <form class="hero-search" action={url('/services/')} method="get" role="search">
        <label for="hero-q" class="visually-hidden">搜尋服務、表單或公告</label>
        <input id="hero-q" name="q" type="search" placeholder="搜尋：兵役、工讀、遺失物…" autocomplete="off" />
        <button type="submit" class="btn">搜尋</button>
      </form>
    </div>
  </section>

  <section class="section audience" aria-labelledby="aud-title">
    <div class="wrap aud-grid">
      <h2 id="aud-title" class="aud-title">依身分找服務</h2>
      <ul class="aud-list">
        {audiences.map((a) => (
          <li><a href={url(`/services/?for=${encodeURIComponent(a)}`)}>{a}</a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="news-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="news-title" class="section-title">最新消息</h2>
        <a href={url('/news/')}>全部消息</a>
      </div>
      <NewsList items={latest} />
    </div>
  </section>

  <section class="section" aria-labelledby="help-title">
    <div class="wrap help-grid">
      <div>
        <h2 id="help-title" class="section-title">不知道該找誰？</h2>
        <p class="help-lede">先打學務處總機，說明你遇到的事，會幫你轉到負責的人。不想打電話，也可以寫信到學務處意見信箱。</p>
        <dl class="help-lines">
          <div>
            <dt>學務處總機（上班時間）</dt>
            <dd><a class="tnum" href={tel(site.mainPhone)}>{site.mainPhone}</a></dd>
          </div>
          {mailbox && (
            <div>
              <dt>意見信箱</dt>
              <dd><a href={`mailto:${mailbox}`}>{mailbox}</a></dd>
            </div>
          )}
          {duty && (
            <div class="help-duty">
              <dt>下班後、假日或緊急時</dt>
              <dd><a class="tnum" href={tel(duty.phone)}>{phoneMain(duty.phone)}</a> <span>校安中心，24 小時</span></dd>
            </div>
          )}
        </dl>
      </div>
      <div>
        <h2 class="section-title" id="sys-title">常用線上系統</h2>
        <ul class="link-list" aria-labelledby="sys-title">
          {systems.map((s) => (
            <li>
              <a href={s.link!.url} rel="noopener">
                <span class="ll-title ext">{s.label}</span>
                <span class="ll-meta">{new URL(s.link!.url).hostname}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="units-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="units-title" class="section-title">負責單位</h2>
        <a href={url('/units/')}>單位與聯絡方式</a>
      </div>
      <ul class="unit-cols">
        {units.map((u) => (
          <li>
            <a href={url(`/units/${u.slug}/`)} class="unit-name">{u.name}</a>
            <p>{u.summary}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(var(--space-7), 8vw, var(--space-9)) var(--space-7);
  }
  .hero-lead {
    font-size: clamp(var(--s5), 11vw, 7.5rem);
    font-weight: 900;
    line-height: 1;
    color: var(--brand);
    letter-spacing: 0.02em;
  }
  .phrases {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.15em 0.55em;
    margin-top: var(--space-4);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(var(--s3), 5.2vw, var(--s6));
    line-height: 1.3;
    max-width: 22em;
  }
  .phrase {
    color: var(--ink);
    text-decoration: none;
    background-image: linear-gradient(var(--marker), var(--marker));
    background-repeat: no-repeat;
    background-position: 0 88%;
    background-size: 0% 0.38em;
    transition: background-size 260ms cubic-bezier(.2, .7, .2, 1);
    border-radius: 2px;
  }
  .phrase:hover,
  .phrase:focus-visible {
    background-size: 100% 0.38em;
  }
  .phrase:focus-visible { outline-offset: 4px; }
  .phrase-more {
    color: var(--brand);
    font-size: 0.5em;
    align-self: center;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
    background-image: none;
  }

  .hero-search {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-7);
    max-width: 40rem;
  }
  .hero-search input {
    flex: 1;
    min-width: 0;
    min-height: 52px;
    padding: 0 var(--space-5);
    border-radius: 999px;
    border: 2px solid var(--line);
    background: var(--surface);
    color: var(--ink);
    font: inherit;
  }
  .hero-search input::placeholder { color: var(--ink-soft); }
  .hero-search input:focus-visible { border-color: var(--brand); outline-offset: 2px; }
  .hero-search .btn { min-height: 52px; }

  .aud-grid {
    display: grid;
    grid-template-columns: 14rem 1fr;
    gap: var(--space-5);
    align-items: center;
  }
  .aud-title { font-size: var(--s2); }
  .aud-list { list-style: none; display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .aud-list a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--space-5);
    border: 2px solid var(--ink);
    border-radius: 999px;
    color: var(--ink);
    text-decoration: none;
    font-weight: 700;
  }
  .aud-list a:hover { background: var(--ink); color: var(--paper); }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }
  .section-head .section-title { margin: 0; }
  .section-head a { font-weight: 700; white-space: nowrap; }

  .unit-cols {
    list-style: none;
    columns: 2 22rem;
    column-gap: var(--space-7);
  }
  .unit-cols li {
    break-inside: avoid;
    padding-block: var(--space-4);
    border-top: 1px solid var(--line);
  }
  .unit-name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--s1);
    color: var(--ink);
    text-decoration: none;
  }
  .unit-name:hover { color: var(--brand); text-decoration: underline; }
  .unit-cols p { color: var(--ink-soft); margin-top: var(--space-1); max-width: var(--measure); }

  .help-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
  }
  .help-lede { color: var(--ink-soft); max-width: var(--measure); }
  .help-lines { margin: var(--space-5) 0 0; display: grid; gap: var(--space-4); }
  .help-lines dt { font-size: var(--s-1); color: var(--ink-soft); }
  .help-lines dd { margin: 0; font-family: var(--font-display); font-weight: 800; font-size: var(--s2); }
  .help-lines dd a { color: var(--ink); text-decoration: none; }
  .help-lines dd a:hover { text-decoration: underline; }
  .help-lines dd span { font-family: var(--font-body); font-weight: 400; font-size: var(--s-1); color: var(--ink-soft); }
  .help-duty { padding-left: var(--space-4); border-left: 4px solid var(--alert); }
  .help-duty dd a { color: var(--alert); }
  .ll-meta { overflow: hidden; text-overflow: ellipsis; }

  @media (max-width: 860px) {
    .help-grid { grid-template-columns: 1fr; gap: var(--space-6); }
  }
  @media (max-width: 760px) {
    .aud-grid { grid-template-columns: 1fr; }
    .hero-search { flex-direction: column; }
  }
</style>
